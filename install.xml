<?xml version="1.0" encoding="utf-8"?>
<modification>
	<name>Sucuri Cache</name>
	<code>sucuri_cache_menu</code>
	<version>1.1.0</version>
	<author>Nikos Tinginagkas</author>
	<link></link>
	<!--
		Adds "Sucuri Cache" under System > Maintenance, so a post-deploy edge
		purge does not require digging through Extensions > Modules. The label
		is a proper noun, identical in every language, so it needs no language key.
	-->
	<file path="admin/controller/common/column_left.php">
		<operation>
			<search><![CDATA[if ($maintenance) {]]></search>
			<add position="before"><![CDATA[
			if ($this->user->hasPermission('access', 'extension/module/sucuri_cache')) {
				$maintenance[] = array(
					'name'	   => 'Sucuri Cache',
					'href'     => $this->url->link('extension/module/sucuri_cache', 'user_token=' . $this->session->data['user_token'], true),
					'children' => array()
				);
			}
]]></add>
		</operation>
	</file>
	<!--
		Sucuri Cache is an admin tool, not a storefront block. Keep it out of the
		module list in Design > Layouts, where OpenCart would otherwise offer it
		because the module has a status setting.
	-->
	<file path="admin/controller/design/layout.php">
		<operation error="skip">
			<search><![CDATA[if ($this->config->has('module_' . $code . '_status') || $module_data) {]]></search>
			<add position="replace"><![CDATA[if (($this->config->has('module_' . $code . '_status') || $module_data) && $code != 'sucuri_cache') {]]></add>
		</operation>
	</file>
</modification>
